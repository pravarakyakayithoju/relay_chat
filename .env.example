# Copy to .env only if you want to override a default. Every value below is
# already the default for local development, so the project runs without it.

# --- shared by api, gateway and workers ---
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-me
LOG_LEVEL=info

# --- api ---
PORT=3000
# Optional read replica for message history and search (see docs/phases/05-read-scaling.md)
DATABASE_READ_URL=
# Optional fixed Snowflake node id (0-1023). Derived from the hostname if unset.
NODE_ID=
# Rate limits (requests per minute per IP on auth; messages per 10 s per user)
AUTH_RATE_LIMIT=20
SEND_RATE_LIMIT=30
# Seconds the first page of channel history is cached in Redis. 0 disables the cache.
RECENT_CACHE_TTL_SECONDS=30

# --- gateway ---
GATEWAY_PORT=4000

# --- workers ---
# Port 19092 is the listener Redpanda exposes to your laptop; containers use redpanda:9092.
KAFKA_BROKERS=localhost:19092
# Which workers this process runs. Any of: outbox,notifications,search,previews
WORKERS=outbox,notifications,search,previews
WORKERS_METRICS_PORT=9100
